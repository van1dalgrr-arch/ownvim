// ownvim — все настройки по умолчанию. Этот файл не правь: поменять что-то — напиши это в settings.jsonc
// (пробел f c или :Settings). Там достаточно только изменённого — остальное берётся отсюда.
// Сохранил settings.jsonc — тема, опции, клавиши и настройки модулей применились сразу;
// включить/выключить модуль или плагин — после :restart.
{
  // Тема: имя, или { "dark": …, "light": … } — по тёмной/светлой теме системы, или "auto" — выбранная в alt-s.
  // Свои JSON-темы — themes/<имя>.json: dev-night, dev-day, sunset; новая — :ThemeNew <имя>, правка — :ThemeEdit,
  // из VS Code — :ThemeInstall <издатель.расширение>. Темы-плагины тоже: "tokyonight", "rose-pine", "kanagawa",
  // "carbonfox", "cyberdream", "vesper", "gruvbox-material", "catppuccin-mocha"…
  "theme": { "dark": "dev-night", "light": "dev-day" },

  // Свои цвета поверх любой темы, как workbench.colorCustomizations в VS Code (только для JSON-тем):
  //   "colors": { "palette": { "accent": "#f472b6" }, "syntax": { "comment": { "fg": "#6b7280", "italic": false } },
  //               "groups": { "LineNr": { "fg": "#444444" } },
  //               "[dev-night]": { "palette": { "bg": "#000000" } } } — только для этой темы
  "colors": {},

  // Иконки: тема — icons/<имя>.json: material (папки со своими значками), default, mono (один цвет), accent (цвет акцента), backend (Go/SQL/Docker
  // заметнее), ascii (без Nerd Font). Выбрать — :IconTheme; по ссылке — :IconThemeInstall; своя — скопируй любую.
  // overrides — свои значки поверх: { "extension": { "go": { "glyph": "\ue627", "color": "cyan" } }, "file": {…},
  // "directory": {…}, "filetype": {…}, "lsp": { "Function": {…} } }; цвет — red…pink, grey, accent или "#rrggbb"
  "icons": {
    "theme": "material", // material — у папок свой значок по смыслу; default, backend, accent, mono, ascii
    "overrides": {},
  },

  // Статусная строка — блоки, как элементы status bar в VS Code. Стили: "bubbles", "arrows", "slant", "flat", "plain".
  // Блоки: mode, branch, diagnostics, file, filetype, encoding, indent, lsp, diff, position, progress, time, search, macro,
  // ext (надписи Go-расширений: тесты в фоне ✓ 42 / ✗ 1 и свои), rest (пора отдохнуть / ☕ перерыв), quiet (тихий режим)
  // и свои из custom: { "имя": { "text": "…", "color": "pink" } } или { "shell": "команда", "every_ms": 10000, "icon": "…" }
  "statusline": {
    "style": "bubbles",
    "left": ["mode", "branch", "diagnostics", "file"],
    "right": ["rest", "quiet", "search", "macro", "ext", "diff", "lsp", "position", "time"],
    "path": "relative", // "name" — только имя файла, "full" — от ~
    "time_format": "%H:%M",
    "mode_names": {}, // свои подписи: { "n": "NORMAL", "i": "INSERT" }
    "custom": {},
  },

  // Дерево файлов (пробел e): своё — вид и поведение отсюда; "engine": "snacks" — дерево snacks
  // В дереве: enter/l — открыть, h — свернуть, a — создать (/ — папка), r — переименовать, d — удалить (в корзину),
  // y — путь, c/x/p — копировать/вырезать/вставить, s — справа, H — скрытые, - — выше, . — корень, ? — помощь, q — закрыть
  "explorer": {
    "engine": "own",
    "side": "left",
    "width": 32,
    "hidden": false, // скрытые файлы (.env, .github)
    "ignore": [".git", ".DS_Store", "node_modules"],
    "git": true, // цвет изменённых и новых, буква справа
    "diagnostics": true, // ● у файлов и папок с ошибками
    "indent": "│ ", // "  " — без линий
    "compact": true, // папка с одной папкой — одной строкой: internal/user/repo
    "follow": true, // подсвечивать открытый файл
    "folder_icons": { "open": "\uf07c", "closed": "\uf07b" },
  },

  // Вкладки, как в VS Code: клик — перейти, клик по крестику или средней кнопкой — закрыть; shift-h/l — соседняя
  "tabline": {
    "show": "auto", // "auto" — когда файлов больше одного, "always", "never"
    "style": "underline", // текущая: "underline" (линия цвета акцента), "bar" (полоса слева), "slant", "plain"
    "close_button": true,
    "icons": true,
    "max_name": 24,
    "modified": "●",
  },

  // Хлебные крошки в верхней строке окна: папка › файл › тип › функция под курсором (по дереву разбора)
  "breadcrumbs": {
    "path": true,
    "symbols": true,
    "separator": " › ",
    "max_depth": 3, // сколько папок показывать
  },

  // Стартовый экран. buttons: do — действие из keys ("files", "recent"…), ":команда" или клавиши.
  // sections: header, buttons, project (ветка, изменения, compose), recent, projects, startup — или любой текст
  "dashboard": {
    "header": [
      " ██████╗ ██╗    ██╗███╗   ██╗",
      "██╔═══██╗██║    ██║████╗  ██║",
      "██║   ██║██║ █╗ ██║██╔██╗ ██║",
      "██║   ██║██║███╗██║██║╚██╗██║",
      "╚██████╔╝╚███╔███╔╝██║ ╚████║",
      " ╚═════╝  ╚══╝╚══╝ ╚═╝  ╚═══╝",
      "своя сборка · настройки в settings.jsonc",
    ],
    "buttons": [
      { "key": "f", "icon": "\uf002", "desc": "Найти файл", "do": "files" },
      { "key": "r", "icon": "\uf1da", "desc": "Недавние файлы", "do": "recent" },
      { "key": "g", "icon": "\uf422", "desc": "Поиск по проекту", "do": "grep" },
      { "key": "c", "icon": "\uf013", "desc": "Мои настройки", "do": "settings" },
      { "key": "t", "icon": "\uf1fc", "desc": "Тема", "do": "themes" },
      { "key": "k", "icon": "\uf11c", "desc": "Все клавиши", "do": "keymaps" },
      { "key": "l", "icon": "\uf487", "desc": "Плагины", "do": ":Lazy" },
      { "key": "q", "icon": "\uf426", "desc": "Выйти", "do": ":qa" },
    ],
    "sections": ["header", "buttons", "project", "startup"],
    "recent": 5,
    "projects": 5,
  },

  // Шрифт — в Ghostty (nvim в терминале сам шрифт не задаёт); общий для всех окон Ghostty. Пусто — шрифт терминала.
  // :Font — выбрать из установленных, :FontInstall Geist Mono — поставить (brew / Nerd Fonts) и включить.
  //   "family": "JetBrains Mono", "size": 14, "ligatures": true, "line_height": "10%", "thicken": false,
  //   "features": ["ss01", "zero"] — OpenType-фичи шрифта
  "font": {},

  // Плавность, как в VS Code — каждое отдельно, на лету
  "animations": {
    "cursor": {
      "enabled": true, // курсор плавно перелетает к новому месту
      "insert": true, // и при наборе (как cursorSmoothCaretAnimation)
      "stiffness": 0.8, // скорость: 1 — мгновенно
      "trailing_stiffness": 0.6, // как быстро догоняет хвост
      "insert_stiffness": 0.9, // скорость во вставке — быстрее, чтобы набор не тянулся
      "min_distance": 2, // сдвиг короче 2 символов (набор, h/l) — без шлейфа, мгновенно; прыжки — плавно
      "between_buffers": true,
    },
    "scroll": { "enabled": true, "duration_ms": 100 }, // плавная прокрутка (ctrl-d, ctrl-u, мышь)
    "indent_scope": { "enabled": false }, // рамка текущего блока проявляется плавно
  },

  // Вид
  "appearance": {
    "transparent": false, // фон из терминала (размытие Ghostty видно сквозь редактор)
    "terminal_edges": true, // Ghostty: поля окна — цветом редактора, без рамки фона терминала по краям (window-padding-color)
    "messages": "modern", // "modern" — длинные сообщения сворачиваются в [+3] без «Press ENTER» (g< — все); "classic" — как в старом vim
  },

  // Переменные vim.g
  "globals": {
    "mapleader": " ",
    "maplocalleader": "\\",
  },

  // Опции nvim (:help options) — как в LazyVim, плюс свои: обычные номера строк, 8 строк вокруг курсора,
  // скруглённые рамки у всплывающих окон
  "options": {
    "clipboard": "unnamedplus", // общий буфер обмена с macOS
    "completeopt": "menu,menuone,noselect",
    "conceallevel": 2,
    "confirm": true, // спросить про несохранённое вместо ошибки
    "cursorline": true,
    "expandtab": true,
    "fillchars": { "foldopen": "\uf47c", "foldclose": "\uf460", "fold": " ", "foldsep": " ", "diff": "╱", "eob": " " },
    "foldlevel": 99,
    "foldmethod": "indent",
    "foldtext": "",
    "formatoptions": "jcroqlnt",
    "grepformat": "%f:%l:%c:%m",
    "grepprg": "rg --vimgrep",
    "ignorecase": true,
    "smartcase": true,
    "inccommand": "nosplit",
    "jumpoptions": "view",
    "laststatus": 3, // одна статусная строка на всё окно
    "linebreak": true,
    "list": true,
    "mouse": "a",
    "number": true,
    "relativenumber": false, // спокойный экран; пробел u L — включить
    "pumblend": 10,
    "pumheight": 10,
    "ruler": false,
    "scrolloff": 8,
    "sidescrolloff": 8,
    "shiftround": true,
    "shiftwidth": 2,
    "tabstop": 2,
    "showmode": false, // режим и так в статусной строке
    "signcolumn": "yes",
    "smartindent": true,
    "smoothscroll": true,
    "spelllang": "en", // "en,ru" — и русский: при первом файле nvim предложит скачать словарь
    "splitbelow": true,
    "splitright": true,
    "splitkeep": "screen",
    "termguicolors": true,
    "timeoutlen": 300, // which-key появляется быстро
    "undofile": true,
    "undolevels": 10000,
    "updatetime": 200,
    "virtualedit": "block",
    "wildmode": "longest:full,full",
    "winminwidth": 5,
    "wrap": false,
    "winborder": "rounded",
  },

  // Модули: true — включён, false — выключен, объект — включён с настройками.
  // Что внутри каждого — lua/own/modules/<имя>.lua (комментарий в начале файла).
  "modules": {
    "basics": true, // подсветка скопированного, курсор на прошлом месте, q закрывает служебные окна…
    "ui": true, // стартовый экран, статусная строка, which-key, линии отступов
    "picker": true, // поиск файлов и текста, дерево файлов
    "treesitter": {
      "languages": ["bash", "c", "diff", "go", "gomod", "gosum", "gowork", "html", "javascript", "json", "lua", "luadoc",
        "markdown", "markdown_inline", "printf", "python", "query", "regex", "sql", "toml", "typescript", "vim", "vimdoc",
        "xml", "yaml", "dockerfile", "http", "cpp", "cmake", "make"],
      "indent": true,
      "folds": true,
      "auto_install": true, // парсер другого языка — сам, когда открыл его файл
    },
    "editing": true, // скобки, текстовые объекты, обрамление, flash, TODO
    "font": true, // шрифт в Ghostty из раздела font ниже
    "tabline": true, // вкладки сверху, как в VS Code (раздел tabline ниже)
    "breadcrumbs": true, // хлебные крошки: папка › файл › функция (раздел breadcrumbs ниже)
    "statusline": true, // своя статусная строка (раздел statusline ниже)
    "icons": true, // темы иконок (раздел icons ниже)
    "themes": true, // свои Dev Night/Day, Sunset, tokyonight, rose-pine, One Dark Pro, GitHub, Dark+, Dracula, Monokai Pro, Material, Ayu… — alt-s
    "modes": {
      "auto_normal_ms": 5000, // не печатаешь 5 с — выход из вставки; 0 — никогда
      "escape": ["jk", "ол"], // быстро две буквы — выход из вставки (первая сразу становится текстом); [] — выкл
      "escape_ms": 200, // сколько ждать вторую букву
    },
    "commands": true, // свои команды-скрипты на Python и др. (раздел commands ниже, docs/extensions.ru.md)
    "sessions": true, // сессии проектов: вкладки и разбиения возвращаются (раздел sessions ниже)
    "autosave": true, // файл пишется сам, изменения снаружи подхватываются
    "russian": {
      "langmap": true, // команды работают в русской раскладке: о = j, вв = dd, Ж = :
      "alt_keys": true, // alt-буквы в keys работают и в русской раскладке
    },
    "scrollbar": true, // полоса прокрутки с метками ошибок, git и найденного
    "animations": true, // плавный курсор и прокрутка (раздел animations ниже)
    "brackets": { "colors": ["yellow", "purple", "blue"] }, // цветные пары скобок, как в VS Code
    "sticky_scroll": { "max_lines": 3 }, // шапка функции прилипает сверху, как Sticky Scroll в VS Code
    // картинка сбоку вместо миникарты (своя у каждой темы — "themes" или "image" в файле темы); пробел u p
    // панели как в VS Code: полоса значков слева (клик — файлы, поиск, git, тесты, отладка, плагины, настройки)
    // и нижняя панель «Терминал · Проблемы · Задачи» (пробел j). items: files, search, git, tests, debug, plugins,
    // database, claude, settings
    "panels": {
      "activity_bar": { "enabled": true, "items": ["files", "search", "git", "tests", "debug", "plugins", "settings"] },
      "bottom": { "height": 12, "tabs": ["terminal", "problems", "tasks"] },
    },
    "image_panel": { "enabled": false, "image": "", "side": "right", "width": 32, "themes": {}, "auto": true },
    "minimap": false, // миникарта справа, как в VS Code ({ "width": 18 }); полоса прокрутки с метками — легче
    "completion": true, // автодополнение (раздел completion ниже)
    "format": true, // форматирование при сохранении (раздел format ниже)
    "lint": true, // линтеры: golangci-lint, hadolint (раздел lint ниже)
    "test": true, // тесты: neotest (раздел test ниже)
    "debug": true, // отладчик: dap + delve (раздел debug ниже)
    "database": true, // база данных: dadbod (раздел database ниже)
    "go": true, // Go как в GoLand: ▶, действия с превью, генерация, peek, покрытие (раздел go ниже)
    "tasks": true, // задачи, как ctrl-r в Zed (раздел tasks ниже)
    "ai": true, // Claude Code в nvim (раздел ai ниже)
    "http": true, // Postman в файле (.http) и эндпоинты Gin
    "autotest": true, // тесты Go в фоне после сохранения
    "error_lens": { "preset": "modern", "break_after": 60, "insert": true }, // ошибки справа от строки, как Error Lens; insert — и во вставке
    "multicursor": true, // мультикурсоры: ctrl-n, пробел m
    "dial": { // ctrl-a / ctrl-x: свои циклы по языкам (по слову, если в паре есть буквы)
      "go": [[":=", "="], ["==", "!="], ["var", "const"], ["Error", "Fatal"], ["Errorf", "Fatalf"],
        ["Debug", "Info", "Warn"], ["Println", "Printf", "Print"],
        ["MethodGet", "MethodPost", "MethodPut", "MethodPatch", "MethodDelete"], ["GET", "POST", "PUT", "PATCH", "DELETE"],
        ["StatusOK", "StatusCreated", "StatusNoContent", "StatusBadRequest", "StatusUnauthorized", "StatusNotFound", "StatusInternalServerError"]],
    },
    "cloak": true, // секреты в .env под звёздочками
    "yanky": true, // история копирования: пробел p
    "files": true, // yazi, найти-заменить по проекту, структурная замена, правка списка ошибок
    "comfort": true, // enter — прыжок на строку по метке
    "learn": { "hints_visible": false, "hardtime": true }, // подсказки движений и тренер привычек (подсказывает, не мешает)
    "system": { "containers": "orbstack", "github": "gw" }, // alt-o — контейнеры, alt-w — GitHub, пробел P — скриншот кода
    "rest": { "work_min": 50, "break_min": 5, "show": "due" }, // отдых: напомнить о перерыве после 50 минут непрерывной работы; "always" — показывать время
    "checks": true, // свои проверки без кода (раздел checks): команда на событие, ошибки — на строках
    "quiet": true, // тихий режим (пробел uq): { "hide": ["inlay_hints", "error_lens", "codelens", "blame", "implements", "animations", "indent", "sticky_scroll", "breadcrumbs", "scrollbar"] }
    "rust": true, // Rust: версии зависимостей в Cargo.toml (crates.nvim), отладка «собрать и отладить» — F9
    "docker": true, // compose: статус сервисов справа, enter — действия, ${VAR} ↔ .env; Dockerfile: вес слоёв
    "kubernetes": true, // пробел k — kubectl.nvim (если есть kubectl)
    "git": true, // изменения на полях, blame, merge, история, lazygit (раздел git ниже)
    "lsp": true, // языковые серверы: ошибки, переходы, переименование (разделы lsp, diagnostics, tools ниже)
  },

  // Свои плагины: "автор/плагин": true — поставить, false — убрать (и из модуля тоже),
  // объект — как в lazy.nvim: { "opts": {…}, "event": "VeryLazy", "cmd": "…", "ft": "go", "keys": [["<leader>z", ":Zen<cr>"]] }
  "plugins": {},

  // Языковые серверы. "servers": "имя": true — как в nvim-lspconfig, объект — свои настройки
  // (cmd, filetypes, settings, init_options, root_markers… — как vim.lsp.config), false — выключить.
  // Имена: github.com/neovim/nvim-lspconfig/tree/master/lsp. Сохранил — серверы включились, settings ушли в работающие.
  "lsp": {
    "inlay_hints": { "enabled": true, "exclude": [] }, // подсказки типов в строке; пробел u h — выкл
    "codelens": true, // надписи над кодом: в go.mod — tidy / обновить / govulncheck, над //go:generate — запуск
    "servers": {
      // Go
      "gopls": {
        "settings": {
          "gopls": {
            "gofumpt": true,
            "diagnosticsDelay": "300ms", // ошибки — через 0,3 с после последней клавиши (по умолчанию 1 с)
            "staticcheck": true,
            "usePlaceholders": true,
            "completeUnimported": true,
            "semanticTokens": true,
            "directoryFilters": ["-.git", "-.vscode", "-.idea", "-node_modules"],
            "analyses": { "nilness": true, "unusedparams": true, "unusedwrite": true, "useany": true, "shadow": true }, // shadow — err := внутри if затеняет внешний
            "hints": {
              "assignVariableTypes": true, "compositeLiteralFields": true, "compositeLiteralTypes": true,
              "constantValues": true, "functionTypeParameters": true, "rangeVariableTypes": true,
              "parameterNames": false, // «a...:» в fmt.Println( — шум; true — имена аргументов в каждом вызове
            },
            // test: false — тесты запускает ▶ слева, а не надпись над функцией
            "codelenses": { "generate": true, "test": false, "tidy": true, "upgrade_dependency": true, "vendor": true, "run_govulncheck": true },
          },
        },
      },
      // golangci-lint как сервер дублирует ошибки gopls на строке 1 — он работает линтером при сохранении (раздел lint)
      "golangci_lint_ls": false,
      // SQL (Postgres): синтаксис и типы; с подключением к базе — ещё и таблицы (postgres-language-server.jsonc)
      "postgres_lsp": { "root_markers": ["postgres-language-server.jsonc", ".git"], "workspace_required": false },
      // Docker: Dockerfile, compose, bake — официальный сервер Docker
      "docker_language_server": true,
      // C / C++: clangd из системы (Apple знает пути к заголовкам macOS) — дополнение, ошибки, clang-tidy, .h ↔ .cpp.
      // Проект собирается с compile_commands.json (cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON) — тогда clangd знает флаги
      "clangd": {
        "cmd": ["clangd", "--background-index", "--clang-tidy", "--header-insertion=iwyu", "--completion-style=detailed",
          "--function-arg-placeholders", "--fallback-style=llvm"],
        "init_options": { "usePlaceholders": true, "completeUnimported": true, "clangdFileStatus": true },
      },
      "neocmake": true, // CMakeLists.txt: дополнение команд и переменных, ошибки
      // Python
      "basedpyright": true,
      "ruff": true,
      // Rust: clippy при сохранении; подсказки имён параметров выключены (шумят), «}» подписывается только у длинных блоков
      "rust_analyzer": {
        "settings": {
          "rust-analyzer": {
            "check": { "command": "clippy" },
            "inlayHints": { "parameterHints": { "enable": false }, "closingBraceHints": { "minLines": 30 } },
          },
        },
      },
      // JSON и YAML (settings.jsonc, package.json, k8s, GitHub Actions)
      "jsonls": true,
      "yamlls": true,
    },
  },

  // Ошибки и предупреждения — как vim.diagnostic.config. Уровни можно словами: "error", "warn", "info", "hint"
  "diagnostics": {
    "underline": true,
    "update_in_insert": true, // ошибки обновляются прямо во вставке, пока печатаешь
    "severity_sort": true,
    "virtual_text": { "spacing": 4, "source": "if_many", "prefix": "●" },
    "signs": { "text": { "error": "\uf057 ", "warn": "\uf071 ", "hint": "\uf0eb ", "info": "\uf05a " } },
    "float": { "border": "rounded", "source": "if_many" },
  },

  // Автодополнение. Свои сниппеты — snippets/<язык>.json (формат VS Code); Go: ife, errw, tt, bench, gh…
  "completion": {
    "sources": ["lsp", "path", "snippets", "buffer"], // откуда предлагать
    "ghost_text": true, // продолжение серым прямо в строке
    "auto_show": true, // меню само; false — только по ctrl-space
    "documentation": true, // описание выбранного справа
    "signature": true, // подсказка аргументов при наборе вызова
    "auto_brackets": true, // скобки после функции
    "friendly_snippets": true, // готовые сниппеты для всех языков; false — только свои из snippets/
    "keymap": "vscode", // tab и enter — принять (в шаблоне tab — к следующему полю); "enter", "super-tab", "default" (ctrl-y)
    "max_height": 10,
    "border": "rounded",
    "blink": {}, // любые настройки blink.cmp как есть: cmp.saghen.dev/configuration/reference
  },

  // Форматирование: при сохранении (и автосохранении) и по пробел c f; пробел u f — выкл на время.
  // Форматтеры по порядку, имена — github.com/stevearc/conform.nvim#formatters. Ставятся сами (tools.install).
  "format": {
    "on_save": true,
    "timeout_ms": 3000,
    "lsp": "fallback", // нет своих форматтеров — форматирует сервер; "never", "prefer", "first", "last"
    "languages": {
      "go": ["goimports", "gofumpt"],
      "sql": ["pg_format"],
      "python": ["ruff_organize_imports", "ruff_format"],
      "rust": ["rustfmt"],
      "c": ["clang_format"], // стиль — .clang-format проекта, нет его — LLVM
      "cpp": ["clang_format"],
      "sh": ["shfmt"],
      "toml": ["taplo"],
    },
    // настройки форматтеров, как в conform: command, args, prepend_args, cwd…
    "formatters": {
      "pg_format": { "prepend_args": ["--spaces", "2", "--keyword-case", "2", "--type-case", "2"] }, // 2 — ЗАГЛАВНЫЕ
      "shfmt": { "prepend_args": ["-ci"] }, // отступ shfmt берёт из shiftwidth файла
    },
  },

  // Линтеры — проверки сверх языкового сервера. Имена: github.com/mfussenegger/nvim-lint#available-linters
  "lint": {
    "events": ["BufReadPost", "BufWritePost", "InsertLeave"],
    "languages": {
      "go": ["golangcilint"], // берёт .golangci.yml проекта
      "dockerfile": ["hadolint"],
    },
    // настройки линтеров, как в nvim-lint (cmd, args, ignore_exitcode…)
    "linters": {
      // код не собирается — golangci-lint падает с кодом 3; ошибки сборки и так показывает gopls
      "golangcilint": { "ignore_exitcode": true },
    },
  },

  // Тесты (neotest). adapters: имя → настройки (true — по умолчанию, false — выкл);
  // свой адаптер — { "repo": "автор/плагин", … }. Известные: neotest-golang, neotest-python, neotest-rust (нужен cargo-nextest)
  "test": {
    "adapters": {
      "neotest-golang": { "go_test_args": ["-v", "-race", "-count=1", "-timeout=60s"], "dap_go_enabled": true },
      "neotest-python": true,
    },
    "status": { "virtual_text": true, "signs": true },
    "output": { "open_on_run": false }, // вывод — пробел t o
    "diagnostic": { "enabled": true, "severity": "error" }, // упавшая проверка — ошибкой на её строке
    "failed_as_error": true, // Go: t.Errorf в упавшем тесте — ошибка, t.Log в прошедшем — подсказка
  },

  // Отладчик (nvim-dap). Для Go — delve (ставится сам)
  "debug": {
    "ui": true, // панели переменных, стека, точек останова — сами при старте отладки
    "virtual_text": true, // значения переменных серым прямо в коде
    "signs": { "breakpoint": "●", "condition": "◆", "rejected": "○", "log": "◉", "stopped": "→" },
    // C / C++ / Rust: codelldb (ставится сам). Свои конфигурации — как в nvim-dap; в значениях:
    // "${prompt:Текст: }" — спросить при запуске, "${pick_process}" — выбрать процесс
    "cpp": {
      "configurations": [
        {
          "name": "Запустить программу", "type": "codelldb", "request": "launch",
          "program": "${prompt:Программа: }", "args": [], "cwd": "${workspaceFolder}", "stopOnEntry": false,
        },
        { "name": "Подключиться к процессу", "type": "codelldb", "request": "attach", "pid": "${pick_process}" },
      ],
    },
    "go": {
      "delve": "dlv",
      // свои конфигурации запуска, как в nvim-dap-go. По умолчанию — подключиться к dlv в Docker:
      //   dlv debug ./cmd/api --headless --listen=:2345 --accept-multiclient --api-version=2 (порт 2345 наружу, код в /app)
      "configurations": [
        {
          "type": "go", "name": "Подключиться к dlv в Docker (:2345)", "mode": "remote", "request": "attach",
          "host": "127.0.0.1", "port": "2345", "substitutePath": [{ "from": "${workspaceFolder}", "to": "/app" }],
        },
      ],
    },
  },

  // База данных (dadbod): пробел D / alt-d — подключения и таблицы; в .sql — дополнение по таблицам
  "database": {
    "connections": {}, // "имя": "postgres://user:pass@localhost:5432/db"
    "project_env": true, // подключение проекта само: DATABASE_URL из .env, иначе postgres://postgres:<DB_PASSWORD>@localhost:5432/<папка>
  },

  // Go
  "go": {
    "run_marks": true, // ▶ слева от func main и TestX: пробел r x — запустить, пробел r X — в отладчике
    "implements": true, // «реализует: io.Reader» рядом с типом
    "coverage_file": "/tmp/cover.out",
  },

  // Задачи (пробел r r, alt-t): when — видна, если в корне есть файл/папка; ft — если открыт файл этого языка;
  // в cmd: ${root}, ${file}, ${file_dir}, ${image}, ${input:Подсказка} — спросить при запуске;
  // "env": ".env" (или список файлов) — переменные проекта для задачи. Свои — "list+": [ … ] в settings.jsonc
  // (дописать к этим). Правка видна сразу, без :restart
  "tasks": {
    "list": [
      { "name": "up — зависимости из compose + приложение", "cmd": "zsh -ic up", "when": ["go.mod"] },
      { "name": "air — hot reload", "cmd": "air", "when": ["go.mod"] },
      { "name": "go run ./cmd/api", "cmd": "go run ./cmd/api", "when": ["go.mod"] },
      { "name": "тесты — весь проект", "cmd": "gotestsum --format pkgname-and-test-fails --format-icons hivis -- ./...", "when": ["go.mod"] },
      { "name": "тесты — пакет текущего файла", "cmd": "gotestsum --format testname -- -count=1 ${file_dir}", "when": ["go.mod"] },
      { "name": "покрытие тестами", "cmd": "go test -coverprofile=/tmp/cover.out ./... && go tool cover -html=/tmp/cover.out", "when": ["go.mod"] },
      { "name": "бенчмарки пакета + pprof", "cmd": "go test -run '^$' -bench . -benchmem -o /tmp/bench.test -cpuprofile /tmp/cpu.out ${file_dir} && go tool pprof -http=:0 /tmp/cpu.out", "when": ["go.mod"] },
      { "name": "golangci-lint", "cmd": "golangci-lint run ./...", "when": ["go.mod"] },
      { "name": "go mod tidy", "cmd": "go mod tidy", "when": ["go.mod"] },
      { "name": "govulncheck", "cmd": "govulncheck ./...", "when": ["go.mod"] },
      { "name": "curl /health", "cmd": "curl -s localhost:${PORT:-8080}/health | jq .", "when": ["go.mod"] },
      { "name": "логи compose", "cmd": "docker compose logs -f --tail 100", "when": ["compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml"] },
      { "name": "docker compose up -d", "cmd": "docker compose up -d --wait", "when": ["compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml"] },
      { "name": "docker compose down", "cmd": "docker compose down", "when": ["compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml"] },
      { "name": "docker compose ps", "cmd": "docker compose ps", "when": ["compose.yaml", "compose.yml", "docker-compose.yml", "docker-compose.yaml"] },
      { "name": "docker build — образ проекта", "cmd": "docker build -t ${image} .", "when": ["Dockerfile"] },
      { "name": "hadolint — текущий Dockerfile", "cmd": "hadolint ${file}", "when": ["Dockerfile"] },
      { "name": "trivy — уязвимости образа", "cmd": "trivy image --severity HIGH,CRITICAL ${image}", "when": ["Dockerfile"] },
      { "name": "cmake: настроить (Debug, compile_commands.json)", "cmd": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && ln -sf build/compile_commands.json .", "when": ["CMakeLists.txt"] },
      { "name": "cmake: собрать", "cmd": "cmake --build build -j", "when": ["CMakeLists.txt"] },
      { "name": "cmake: тесты (ctest)", "cmd": "ctest --test-dir build --output-on-failure", "when": ["CMakeLists.txt"] },
      { "name": "make", "cmd": "make -j", "when": ["Makefile"] },
      { "name": "cargo run", "cmd": "cargo run", "when": ["Cargo.toml"] },
      { "name": "cargo test", "cmd": "cargo test", "when": ["Cargo.toml"] },
      { "name": "cargo clippy — все замечания", "cmd": "cargo clippy --all-targets", "when": ["Cargo.toml"] },
      { "name": "cargo build --release", "cmd": "cargo build --release", "when": ["Cargo.toml"] },
      { "name": "C++: собрать и запустить текущий файл", "cmd": "clang++ -std=c++20 -g -Wall -Wextra -o /tmp/a.out ${file} && /tmp/a.out", "ft": ["cpp"] },
      { "name": "dot project doctor", "cmd": "dot project doctor ${root}" },
      { "name": "dot work — что поднято", "cmd": "dot work" },
    ],
  },

  // Claude Code в nvim
  "ai": {
    "side": "right",
    "width": 0.4,
  },

  // Свои проверки без кода: команда по событию, её вывод «файл:строка:столбец: текст» — замечания на строках.
  // { "run": "команда (${file}, ${root}, ${file_dir})", "pattern": "*.go", "on": ["BufWritePost"], "cwd": "root" | "file",
  //   "severity": "warn", "format": "регулярка с группами file, line, message (col, severity)" }; :Checks — прогнать сейчас
  //   "checks": { "shellcheck": { "run": "shellcheck -f gcc ${file}", "pattern": "*.sh" } }
  "checks": {},

  // Настройки Go-расширений (core/extensions/<имя>, docs/go-extensions.md): "<имя>": { … } — в расширении c.Setting("ключ", умолчание)
  "extensions": {
    "examples": { "max_lines": 40 }, // :LongFuncs — функции длиннее стольких строк красным
  },

  // Свои команды-скрипты (docs/extensions.ru.md): скрипт читает stdin, пишет stdout.
  // input: selection | file | line | word | none; output: replace | insert | window | notify | none
  // :ExtensionNew имя — заготовка extensions/имя.py + строка здесь; :Commands (пробел C) — список
  "commands": {
    "Сортировать строки": { "run": "python3 extensions/sort_lines.py", "input": "selection", "output": "replace", "key": "x <leader>xs" },
    "Инфо о файле": { "run": "python3 extensions/file_info.py", "input": "file", "output": "notify", "key": "n <leader>xi" },
  },

  // Сессии проектов: открыл ownvim в папке без файлов — вернулось, как было (пробел q s / q S / q d)
  "sessions": {
    "auto_save": true,
    "auto_restore": true,
    "ignore": ["~", "/tmp", "/"], // папки без сессий
  },

  // Git
  "git": {
    "signs": { "add": "▎", "change": "▎", "delete": "\uf431", "topdelete": "\uf432", "changedelete": "▎", "untracked": "▎" },
    "blame": false, // кто и когда менял строку — серым справа (пробел u B — на время)
    "blame_format": "<author>, <author_time:%d.%m.%Y> · <summary>",
    "base_branch": "auto", // с чем сравнивать ветку (пробел g m): auto — origin/HEAD, или "main", "develop"…
  },

  // Откуда брать серверы, форматтеры и линтеры: "mason" — ставит сам при первом запуске (в ~/.local/share/ownvim/mason),
  // "system" — только то, что уже есть в PATH (brew и т.п.)
  "tools": {
    "install": "mason",
  },

  // Всё ставится само: открыл файл языка, для которого ничего не настроено, — ownvim включает
  // языковой сервер, форматтер и линтер и ставит их через mason (не спрашивая, как просил бы VS Code).
  // languages — проверенный набор; любой другой язык ищется в реестре mason ("discover"): один сервер —
  // ставится, несколько — спросит один раз. Язык: false — ничего не ставить. Свой список — сюда же или в
  // lsp/format/lint (settings.jsonc всегда сильнее). Что включилось — :AutoTools; :AutoTools <язык> — забыть.
  "auto": {
    "enabled": true,
    "discover": true,
    "languages": {
      "typescript": { "lsp": ["vtsls"], "format": ["prettierd"] },
      "javascript": { "lsp": ["vtsls"], "format": ["prettierd"] },
      "typescriptreact": { "lsp": ["vtsls"], "format": ["prettierd"] },
      "javascriptreact": { "lsp": ["vtsls"], "format": ["prettierd"] },
      "svelte": { "lsp": ["svelte"], "format": ["prettierd"] },
      "astro": { "lsp": ["astro"], "format": ["prettierd"] },
      "html": { "lsp": ["html"], "format": ["prettierd"] },
      "css": { "lsp": ["cssls"], "format": ["prettierd"] },
      "scss": { "lsp": ["cssls"], "format": ["prettierd"] },
      "less": { "lsp": ["cssls"], "format": ["prettierd"] },
      "graphql": { "lsp": ["graphql"], "format": ["prettierd"] },
      "markdown": { "lsp": ["marksman"], "format": ["prettierd"] },
      "lua": { "lsp": ["lua_ls"], "format": ["stylua"] },
      "sh": { "lsp": ["bashls"], "lint": ["shellcheck"] },
      "bash": { "lsp": ["bashls"], "format": ["shfmt"], "lint": ["shellcheck"] },
      "toml": { "lsp": ["taplo"] },
      "zig": { "lsp": ["zls"] },
      "php": { "lsp": ["intelephense"] },
      "terraform": { "lsp": ["terraformls"] },
      "proto": { "lsp": ["buf_ls"], "format": ["buf"] },
      "xml": { "lsp": ["lemminx"] },
      "tex": { "lsp": ["texlab"] },
      "helm": { "lsp": ["helm_ls"] },
      "nix": { "lsp": ["nil_ls"] },
      // не код — серверы проверки орфографии и грамматики сюда не нужны
      "text": false, "gitcommit": false, "gitrebase": false, "log": false, "csv": false, "tsv": false,
      "conf": false, "mail": false, "diff": false, "help": false,
    },
  },

  // Клавиши: "режимы клавиша": что делать. Режимы — буквы подряд: n обычный, i вставка, x выделение,
  // s выбор, o после оператора, t терминал, c командная строка.
  // Что делать: имя действия ("files" — список в пробел s k и lua/own/actions.lua), клавиши ("<C-w>h"),
  // команда (":Lazy"), объект { "do": "gcc", "remap": true, "desc": "…" } или false — убрать.
  "keys": {
    // движение
    "nx j": "down",
    "nx k": "up",
    "nx <Down>": "down",
    "nx <Up>": "up",
    "n n": "search.next",
    "n N": "search.prev",
    "ins <esc>": "esc",

    // окна
    "n <C-h>": { "do": "<C-w>h", "desc": "Окно слева" },
    "n <C-j>": { "do": "<C-w>j", "desc": "Окно снизу" },
    "n <C-k>": { "do": "<C-w>k", "desc": "Окно сверху" },
    "n <C-l>": { "do": "<C-w>l", "desc": "Окно справа" },
    "n <C-Up>": { "do": ":resize +2", "desc": "Окно выше" },
    "n <C-Down>": { "do": ":resize -2", "desc": "Окно ниже" },
    "n <C-Left>": { "do": ":vertical resize -2", "desc": "Окно уже" },
    "n <C-Right>": { "do": ":vertical resize +2", "desc": "Окно шире" },
    "n <leader>-": { "do": "<C-w>s", "desc": "Разделить вниз" },
    "n <leader>|": { "do": "<C-w>v", "desc": "Разделить вправо" },
    "n <leader>wd": { "do": "<C-w>c", "desc": "Закрыть окно" },
    "n <leader>wm": "window.zoom",
    "n <leader>uZ": "window.zoom",
    "n <leader>uz": "zen",
    "n <leader>uq": "quiet", // тихий режим: без подсказок типов, плашек, анимаций, крошек — ещё раз вернуть

    // буферы
    "n <S-h>": { "do": ":bprevious", "desc": "Предыдущая вкладка-файл" },
    "n <S-l>": { "do": ":bnext", "desc": "Следующая вкладка-файл" },
    "n [b": { "do": ":bprevious", "desc": "Предыдущий буфер" },
    "n ]b": { "do": ":bnext", "desc": "Следующий буфер" },
    "n <leader>bb": { "do": ":e #", "desc": "Предыдущий буфер" },
    "n <leader>`": { "do": ":e #", "desc": "Предыдущий буфер" },
    "n <leader>bd": "buffer.delete",
    "n <leader>bo": "buffer.others",
    "n <leader>bD": { "do": ":bd", "desc": "Закрыть буфер и окно" },

    // вкладки
    "n <leader><tab><tab>": { "do": ":tabnew", "desc": "Новая вкладка" },
    "n <leader><tab>]": { "do": ":tabnext", "desc": "Следующая вкладка" },
    "n <leader><tab>[": { "do": ":tabprevious", "desc": "Предыдущая вкладка" },
    "n <leader><tab>d": { "do": ":tabclose", "desc": "Закрыть вкладку" },
    "n <leader><tab>o": { "do": ":tabonly", "desc": "Закрыть остальные вкладки" },
    "n <leader><tab>f": { "do": ":tabfirst", "desc": "Первая вкладка" },
    "n <leader><tab>l": { "do": ":tablast", "desc": "Последняя вкладка" },

    // правка
    "nixs <C-s>": "save",
    "nix <D-s>": "save", // cmd-s как в Zed
    // cmd-клавиши как в VS Code: системный буфер обмена, выделить всё, отмена
    "x <D-c>": "clip.copy",
    "n <D-c>": "clip.copy_line",
    "x <D-x>": "clip.cut",
    "n <D-x>": "clip.cut_line",
    "nx <D-v>": "clip.paste",
    "i <D-v>": "clip.paste_insert",
    "c <D-v>": "clip.paste_cmdline",
    "t <D-v>": { "do": "<C-\\><C-n>\"+pi", "desc": "Вставить (cmd-v)" },
    "n <D-a>": "select.all",
    "ni <D-z>": "undo",
    "ni <D-S-z>": "redo",
    "x <": { "do": "<gv", "desc": "Отступ влево (выделение остаётся)" },
    "x >": { "do": ">gv", "desc": "Отступ вправо (выделение остаётся)" },
    "x J": "lines.down", // выделенные строки вниз/вверх (alt-j/k занят AeroSpace)
    "x K": "lines.up",
    "i ,": { "do": ",<c-g>u", "desc": "Запятая + точка отмены" }, // точки отмены на знаках препинания
    "i .": { "do": ".<c-g>u", "desc": "Точка + точка отмены" },
    "i ;": { "do": ";<c-g>u", "desc": "Точка с запятой + точка отмены" },
    "n gco": { "do": "o<esc>Vcx<esc><cmd>normal gcc<cr>fxa<bs>", "desc": "Комментарий строкой ниже" },
    "n gcO": { "do": "O<esc>Vcx<esc><cmd>normal gcc<cr>fxa<bs>", "desc": "Комментарий строкой выше" },
    "n <D-/>": { "do": "gcc", "remap": true, "desc": "Комментарий (cmd-/)" },
    "x <D-/>": { "do": "gc", "remap": true, "desc": "Комментарий (cmd-/)" },

    // файлы и поиск
    "n <leader><space>": "files",
    "n <leader>,": "buffers",
    "n <leader>/": "grep",
    "n <leader>:": "command.history",
    "n <leader>n": "notifications",
    "nx <leader>?": "notes.add", // неудобно — записать вместе с местом; разбор потом
    "n <leader>N": "notes.list",
    "ni <D-p>": "files", // cmd-p как в Zed
    "ni <D-S-p>": "commands",
    "n <leader>ff": "files",
    "n <leader>fF": "files.cwd",
