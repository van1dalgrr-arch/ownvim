  "fetch JSON": {
    "prefix": "fj",
    "body": ["const res = await fetch(${1:url}, { signal: AbortSignal.timeout(${2:10_000}) });", "if (!res.ok) throw new Error(`${1:url}: ${res.status}`);", "const ${3:data} = await res.json();"],
    "description": "fetch с таймаутом и проверкой статуса"
  },
  "параллельно с лимитом": {
    "prefix": "pool",
    "body": [
      "async function pool(items, limit, fn) {",
      "\tconst out = [];",
      "\tlet i = 0;",
      "\tconst workers = Array.from({ length: limit }, async () => {",
      "\t\twhile (i < items.length) {",
      "\t\t\tconst n = i++;",
      "\t\t\tout[n] = await fn(items[n]).catch((err) => ({ error: String(err) }));",
      "\t\t}",
      "\t});",
      "\tawait Promise.all(workers);",
      "\treturn out;",
      "}"
    ],
    "description": "Promise-пул: не больше limit запросов одновременно"
  },
