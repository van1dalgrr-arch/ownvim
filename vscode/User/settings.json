    "editor.formatOnType": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
  },
  "[go.mod]": { "editor.defaultFormatter": "golang.go" },

  // ── SQL: Postgres Language Server (проверки и дополнение по базе) + ownvim (миграции, схема из файлов) ──
  "[sql]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": false,
    "editor.quickSuggestions": { "other": "on", "strings": "on" },
  },
  "sqltools.useNodeRuntime": true,
  "sqltools.autoOpenSessionFiles": false,
  "sqltools.results.location": "current",
  "sqltools.highlightQuery": true,
  "sqltools.disableReleaseNotifications": true,

  // ── Docker / YAML ──────────────────────────────────────────────────────────
  "docker.lsp.telemetry": "off",
  "containers.enableComposeLanguageService": false, // compose — у Docker DX, второй сервер дублирует подсказки
  "containers.containers.groupBy": "Compose Project Name",
  "containers.containers.label": "ContainerName",
  "containers.containers.description": ["State", "Status"],
  "yaml.format.enable": true,
  "yaml.keyOrdering": false,
  "yaml.schemaStore.enable": true,
  "hadolint.cliOptions": ["--no-color"],
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[dockercompose]": {
    "editor.codeLens": false, // «Run Service» не нужны: статус справа, Enter — действия

    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[dockerfile]": { "editor.defaultFormatter": "docker.docker" },

  // ── Python и JS/TS — как в ownvim: ruff, basedpyright, prettier, eslint ──────
  "python.languageServer": "None",
  "basedpyright.analysis.typeCheckingMode": "standard",
  "basedpyright.analysis.inlayHints.variableTypes": true,
  "basedpyright.analysis.inlayHints.functionReturnTypes": true,
  "basedpyright.analysis.inlayHints.callArgumentNames": true,
  "python.testing.pytestEnabled": true,
  "python.terminal.activateEnvironment": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always",
    },
  },
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,
  "typescript.preferences.importModuleSpecifier": "shortest",
  "basedpyright.analysis.autoImportCompletions": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "eslint.useFlatConfig": true,
  "prettier.requireConfig": false,
  "[javascript][typescript][javascriptreact][typescriptreact][json][jsonc][css][html][markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript][typescript][javascriptreact][typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.addMissingImports.ts": "always",
      "source.fixAll.eslint": "always",
    },
  },

  // ── git ────────────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "gitlens.currentLine.enabled": true,
  "gitlens.codeLens.enabled": false,
  "gitlens.statusBar.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.showWelcomeOnInstall": false,
  "gitlens.showWhatsNewAfterUpgrades": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,

  // ── тише ───────────────────────────────────────────────────────────────────
  "telemetry.telemetryLevel": "off",
  "update.showReleaseNotes": false,
  "extensions.ignoreRecommendations": true,
  "security.workspace.trust.enabled": false,
  "redhat.telemetry.enabled": false,
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
