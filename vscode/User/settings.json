// ownvim в VS Code — отдельная копия VS Code (своя папка данных и расширений, ownvim-code),
// основной VS Code из dotfiles не трогается. Файл — ссылка из data/User/settings.json: правишь здесь — применяется сразу.
{
  // ── вид: как ownvim — темы ownvim, тихий интерфейс, без лишних панелей ──────
  "workbench.colorTheme": "Dev Night",
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Monokai",
  "workbench.preferredLightColorTheme": "Dev Day",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "material-product-icons",
  "material-icon-theme.folders.theme": "specific",
  "window.titleBarStyle": "custom",
  "window.commandCenter": true,
  "window.title": "${rootName}${separator}${activeEditorShort}${dirty}",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.labelFormat": "short",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "chat.commandCenter.enabled": false,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.go": "${capture}_test.go",
    "*.up.sql": "${capture}.down.sql",
    "go.mod": "go.sum, go.work, go.work.sum",
    "compose.yaml": "compose.*.yaml, .env, .env.*",
    "compose.yml": "compose.*.yml, .env, .env.*",
    "docker-compose.yml": "docker-compose.*.yml, .env, .env.*",
    "Dockerfile": "Dockerfile.*, .dockerignore",
    "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, bun.lockb, .npmrc",
    "pyproject.toml": "uv.lock, poetry.lock, requirements*.txt, .python-version",
  },
  "breadcrumbs.enabled": true,
  "problems.showCurrentInStatus": true,

  // ── редактор ───────────────────────────────────────────────────────────────
  "editor.fontFamily": "'IBM Plex Mono', 'BlexMono Nerd Font', Menlo, monospace",
  "editor.fontSize": 15,
  "editor.lineHeight": 1.45,
  "editor.fontLigatures": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontWeight": "450",
  "editor.letterSpacing": 0,
  "editor.padding.top": 8,
  "editor.cursorSurroundingLines": 8,
  "editor.smoothScrolling": true,
  "editor.lineNumbers": "relative",
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "boundary",
  "editor.minimap.enabled": false,
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.overviewRulerBorder": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.foldingImportsByDefault": true,
  "editor.showFoldingControls": "mouseover",
  "editor.unicodeHighlight.allowedLocales": { "ru": true },
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.fontSize": 12,
  "editor.codeLens": true,
  "editor.codeLensFontSize": 12,
  "editor.hover.delay": 400,
  "editor.hover.sticky": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.suggest.preview": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.snippetSuggestions": "inline",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on",
  },
  "editor.gotoLocation.multipleReferences": "peek",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.lightbulb.enabled": "onCode",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",
  "files.exclude": { "**/.DS_Store": true, "**/.git": true },
  "files.associations": {
    "*.sql": "sql",
    "compose*.yml": "dockercompose",
    "compose*.yaml": "dockercompose",
    "docker-compose*.yml": "dockercompose",
    "docker-compose*.yaml": "dockercompose",
    "Dockerfile.*": "dockerfile",
    "*.Dockerfile": "dockerfile",
    "Containerfile": "dockerfile",
    ".env.*": "dotenv",
    "*.http": "http",
    "settings.jsonc": "jsonc",
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/dist": true,
    "**/.venv": true,
  },
  "search.smartCase": true,

  // ── Error Lens: ошибка прямо в строке, как в ownvim ─────────────────────────
  "errorLens.enabledDiagnosticLevels": ["error", "warning", "info"],
  "errorLens.messageTemplate": "$message",
  "errorLens.delay": 300,
  "errorLens.gutterIconsEnabled": true,
  "errorLens.gutterIconSet": "circle",
  "errorLens.followCursor": "allLines",

  // ── терминал ───────────────────────────────────────────────────────────────
  "terminal.integrated.fontFamily": "'BlexMono Nerd Font', 'IBM Plex Mono'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.commandsToSkipShell": ["whichkey.show"],

  // ── Vim: ownvim-клавиши; пробел — меню как which-key (VSpaceCode Which Key) ──
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.smartcase": true,
  "vim.ignorecase": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 150,
  "vim.sneak": true,
  "vim.easymotion": false,
  "vim.surround": true,
  "vim.targets.enable": true,
  "vim.foldfix": true,
  "vim.statusBarColorControl": false,
  "vim.showMarksInGutter": false,
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.visual": "block",
  "vim.handleKeys": {
    "<C-a>": true,
    "<C-f>": false,
    "<C-p>": false,
    "<C-b>": false,
    "<C-w>": true,
    "<C-d>": true,
    "<C-u>": true,
    "<C-o>": true,
    "<C-i>": true,
    "<C-r>": true,
    "<C-v>": true,
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["<space>"], "commands": ["whichkey.show"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    { "before": ["g", "I"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"] },
    {
      "before": ["g", "K"],
      "commands": ["editor.action.triggerParameterHints"],
    },
    { "before": ["]", "d"], "commands": ["editor.action.marker.next"] },
    { "before": ["[", "d"], "commands": ["editor.action.marker.prev"] },
    { "before": ["]", "e"], "commands": ["editor.action.marker.next"] },
    { "before": ["[", "e"], "commands": ["editor.action.marker.prev"] },
    {
      "before": ["]", "h"],
      "commands": ["workbench.action.editor.nextChange"],
    },
    {
      "before": ["[", "h"],
      "commands": ["workbench.action.editor.previousChange"],
    },
    { "before": ["]", "]"], "commands": ["editor.action.wordHighlight.next"] },
    { "before": ["[", "["], "commands": ["editor.action.wordHighlight.prev"] },
    { "before": ["H"], "commands": ["workbench.action.previousEditorInGroup"] },
    { "before": ["L"], "commands": ["workbench.action.nextEditorInGroup"] },
    { "before": ["<C-h>"], "commands": ["workbench.action.navigateLeft"] },
    { "before": ["<C-j>"], "commands": ["workbench.action.navigateDown"] },
    { "before": ["<C-k>"], "commands": ["workbench.action.navigateUp"] },
    { "before": ["<C-l>"], "commands": ["workbench.action.navigateRight"] },
    { "before": ["<Esc>"], "commands": [":nohl"] },
    { "before": ["<CR>"], "commands": ["ownvim.docker.enter"] },
    { "before": ["<C-a>"], "commands": ["ownvim.dial.inc"] },
    { "before": ["<C-x>"], "commands": ["ownvim.dial.dec"] },
    { "before": ["g", "p", "d"], "commands": ["editor.action.peekDefinition"] },
    {
      "before": ["g", "p", "r"],
      "commands": ["editor.action.referenceSearch.trigger"],
    },
    {
      "before": ["g", "p", "i"],
      "commands": ["editor.action.peekImplementation"],
    },
    {
      "before": ["g", "p", "t"],
      "commands": ["editor.action.peekTypeDefinition"],
    },
    { "before": ["g", "D"], "commands": ["editor.action.revealDeclaration"] },
    { "before": ["]", "w"], "commands": ["editor.action.marker.next"] },
    { "before": ["[", "w"], "commands": ["editor.action.marker.prev"] },
    { "before": ["<C-s>"], "commands": ["workbench.action.files.save"] },
  ],
  // русская раскладка: команды работают и так (о = j, вв = dd, Ж = :), как langmap в ownvim
