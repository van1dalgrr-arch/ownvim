  // ── меню пробела: те же буквы, что в ownvim (defaults.jsonc → keys) ─────────
  "whichkey.sortOrder": "alphabetically",
  "whichkey.delay": 0,
  "whichkey.bindings": [
    {
      "key": " ",
      "name": "Всё: файлы, команды",
      "type": "command",
      "command": "workbench.action.quickOpen",
    },
    {
      "key": "e",
      "name": "Дерево файлов",
      "type": "command",
      "command": "workbench.view.explorer",
    },
    {
      "key": "0",
      "name": "Левая панель",
      "type": "command",
      "command": "workbench.action.toggleSidebarVisibility",
    },
    {
      "key": "1",
      "name": "Режим: код",
      "type": "command",
      "command": "workbench.view.explorer",
    },
    {
      "key": "2",
      "name": "Режим: тесты",
      "type": "command",
      "command": "workbench.view.testing.focus",
    },
    {
      "key": "3",
      "name": "Режим: отладка",
      "type": "command",
      "command": "workbench.view.debug",
    },
    {
      "key": "4",
      "name": "Режим: git",
      "type": "command",
      "command": "workbench.view.scm",
    },
    {
      "key": "5",
      "name": "Режим: база",
      "type": "command",
      "command": "workbench.view.extension.sqltoolsActivityBarContainer",
    },
    {
      "key": ",",
      "name": "Открытые файлы",
      "type": "command",
      "command": "workbench.action.showAllEditorsByMostRecentlyUsed",
    },
    {
      "key": "/",
      "name": "Поиск по проекту",
      "type": "command",
      "command": "workbench.action.findInFiles",
    },
    {
      "key": ":",
      "name": "Команды",
      "type": "command",
      "command": "workbench.action.showCommands",
    },
    {
      "key": "-",
      "name": "Разделить вниз",
      "type": "command",
      "command": "workbench.action.splitEditorDown",
    },
    {
      "key": "|",
      "name": "Разделить вправо",
      "type": "command",
      "command": "workbench.action.splitEditorRight",
    },
    {
      "key": "`",
      "name": "Предыдущий файл",
      "type": "command",
      "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
    },
    {
      "key": "n",
      "name": "Уведомления",
      "type": "command",
      "command": "notifications.showList",
    },
    {
      "key": "h",
      "name": "Все клавиши",
      "type": "command",
      "command": "workbench.action.openGlobalKeybindings",
    },
    {
      "key": "j",
      "name": "Нижняя панель",
      "type": "command",
      "command": "workbench.action.togglePanel",
    },
    {
