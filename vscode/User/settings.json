      "generate": true,
      "regenerate_cgo": true,
      "test": true,
      "tidy": true,
      "upgrade_dependency": true,
      "vendor": true,
      "run_govulncheck": true,
    },
    "ui.navigation.importShortcut": "Definition",
    "build.directoryFilters": ["-**/node_modules", "-**/.git", "-**/vendor"],
