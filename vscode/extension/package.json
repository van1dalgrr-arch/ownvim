      },
      {
        "command": "ownvim.endpoints",
        "title": "Эндпоинты API (Gin)",
        "category": "ownvim"
      },
      {
        "command": "ownvim.apiHttp",
        "title": "api.http из маршрутов",
        "category": "ownvim"
      },
      {
        "command": "ownvim.commands",
