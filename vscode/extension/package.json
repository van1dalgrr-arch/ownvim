        "title": "Ревью ветки от Claude (замечания на строках)",
        "category": "ownvim"
      },
      {
        "command": "ownvim.review.clear",
        "title": "Ревью: убрать замечания",
        "category": "ownvim"
      },
      {
        "command": "ownvim.notes.add",
        "title": "Записать неудобство",
        "category": "ownvim"
      },
      {
        "command": "ownvim.notes",
        "title": "Неудобства: список",
        "category": "ownvim"
      },
      {
