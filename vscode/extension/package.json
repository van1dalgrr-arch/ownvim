{
  "name": "ownvim",
  "displayName": "ownvim",
  "description": "ownvim в VS Code: миграции и схема SQL, база проекта, Docker в коде, ▶ у main и тестов, эндпоинты, задачи из settings.jsonc, тесты в фоне, ревью Claude, темы",
  "version": "0.1.0",
  "publisher": "van1dal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sql",
    "onLanguage:go",
    "onLanguage:dockercompose",
    "onLanguage:dockerfile",
    "onDebugDynamicConfigurations",
    "onCommand:workbench.action.tasks.runTask",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Arctic",
        "uiTheme": "vs-dark",
        "path": "./themes/arctic.json"
      },
      {
        "label": "Aurora",
        "uiTheme": "vs-dark",
        "path": "./themes/aurora.json"
      },
      {
        "label": "Dev Day",
        "uiTheme": "vs",
        "path": "./themes/dev-day.json"
      },
      {
        "label": "Dev Night",
        "uiTheme": "vs-dark",
        "path": "./themes/dev-night.json"
      },
      {
        "label": "Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk.json"
      },
      {
        "label": "Ember",
        "uiTheme": "vs-dark",
        "path": "./themes/ember.json"
      },
      {
        "label": "Forest",
        "uiTheme": "vs-dark",
        "path": "./themes/forest.json"
      },
      {
        "label": "Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/graphite.json"
      },
      {
        "label": "Matcha",
        "uiTheme": "vs-dark",
        "path": "./themes/matcha.json"
      },
      {
        "label": "Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/midnight.json"
      },
      {
        "label": "Mocha",
        "uiTheme": "vs-dark",
        "path": "./themes/mocha.json"
      },
      {
        "label": "Mono",
        "uiTheme": "vs-dark",
        "path": "./themes/mono.json"
      },
      {
        "label": "Nebula",
        "uiTheme": "vs-dark",
        "path": "./themes/nebula.json"
      },
      {
        "label": "Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/neon.json"
      },
      {
        "label": "Ocean",
        "uiTheme": "vs-dark",
        "path": "./themes/ocean.json"
      },
      {
        "label": "Sunset",
        "uiTheme": "vs-dark",
        "path": "./themes/sunset.json"
      },
      {
        "label": "Zed One Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zed-one-dark.json"
      },
      {
        "label": "Zed One Light",
        "uiTheme": "vs",
        "path": "./themes/zed-one-light.json"
      }
    ],
    "commands": [
      {
        "command": "ownvim.sql.migrations",
        "title": "Миграции: меню",
        "category": "ownvim"
      },
      {
        "command": "ownvim.sql.new",
        "title": "Миграции: новая",
        "category": "ownvim"
      },
      {
        "command": "ownvim.sql.up",
        "title": "Миграции: up — применить все",
        "category": "ownvim"
      },
      {
        "command": "ownvim.sql.down",
        "title": "Миграции: down — откатить последнюю",
        "category": "ownvim"
      },
      {
        "command": "ownvim.sql.redo",
        "title": "Миграции: redo",
        "category": "ownvim"
      },
      {
