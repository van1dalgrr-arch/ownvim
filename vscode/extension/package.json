        "title": "Музыка: пауза / играть",
        "category": "ownvim"
      },
      {
        "command": "ownvim.music.next",
        "title": "Музыка: следующий трек",
        "category": "ownvim"
      },
      {
        "command": "ownvim.music.prev",
        "title": "Музыка: предыдущий трек",
        "category": "ownvim"
      },
      {
