        "category": "ownvim"
      },
      {
        "command": "ownvim.docker.enter",
        "title": "Docker: Enter — действия с сервисом",
        "category": "ownvim"
      },
      {
        "command": "ownvim.docker.containers",
        "title": "Docker: контейнеры",
        "category": "ownvim"
      },
      {
        "command": "ownvim.go.json2struct",
        "title": "Go: JSON → struct с тегами",
        "category": "ownvim"
      },
      {
        "command": "ownvim.run",
        "title": "▶ запустить (main или тест под курсором: Go, Python, JS/TS)",
        "category": "ownvim",
        "icon": "$(play)"
      },
      {
        "command": "ownvim.debug",
        "title": "Отладка (main или тест под курсором)",
        "category": "ownvim",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ownvim.python.scratch",
        "title": "Python: черновик",
        "category": "ownvim"
      },
      {
        "command": "ownvim.ts.scratch",
        "title": "TypeScript: черновик",
        "category": "ownvim"
