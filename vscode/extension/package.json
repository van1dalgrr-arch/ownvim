        "title": "Команды ownvim",
        "category": "ownvim"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "ownvim.sql.run",
          "when": "resourceExtname == .sql",
          "group": "navigation"
        },
        {
          "command": "ownvim.run",
          "when": "editorLangId =~ /^(go|python|javascript|typescript|javascriptreact|typescriptreact)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "cmd+enter",
        "command": "ownvim.sql.run",
        "when": "editorTextFocus && resourceExtname == .sql"
      },
      {
        "key": "cmd+shift+t",
        "command": "ownvim.sql.toggle",
        "when": "editorTextFocus && resourceFilename =~ /\\.(up|down)\\.sql$/"
      }
    ],
    "configuration": {
      "title": "ownvim",
      "properties": {
        "ownvim.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Сохранять самому (с форматированием и импортами): выход из вставки, правка в обычном режиме, переход в другой файл"
        },
        "ownvim.database.url": {
          "type": "string",
          "default": "",
          "description": "Своя база проекта. Пусто — сама: DATABASE_URL из .env, postgres из compose, иначе postgres://postgres:…@localhost:5432/<папка>"
        },
        "ownvim.sql.migrations": {
          "type": "string",
          "default": "",
          "description": "Папка миграций. Пусто — ищется сама: migrations, db/migrations, internal/…/migrations"
        },
        "ownvim.sql.tool": {
          "type": "string",
          "enum": [
            "auto",
            "migrate",
            "goose"
          ],
          "default": "auto",
          "description": "migrate (golang-migrate) или goose; auto — по файлам"
        },
        "ownvim.sql.autoDown": {
          "type": "boolean",
          "default": true,
          "description": "down по up при сохранении, пока down не правили руками"
        },
        "ownvim.sql.status": {
          "type": "boolean",
          "default": true,
          "description": "✓ применена / ○ ждёт в первой строке миграции"
        },
        "ownvim.sql.checks": {
          "type": "boolean",
          "default": true,
          "description": "Предупреждения об опасных миграциях: NOT NULL без DEFAULT, индекс без CONCURRENTLY…"
        },
        "ownvim.docker.composeStatus": {
          "type": "boolean",
          "default": true,
          "description": "Статус сервисов справа в compose-файле"
        },
        "ownvim.docker.intervalMs": {
          "type": "number",
          "default": 3000,
          "description": "Как часто спрашивать docker compose ps, пока compose-файл на экране"
        },
        "ownvim.docker.layers": {
          "type": "boolean",
          "default": true,
          "description": "Вес слоёв в Dockerfile"
        },
        "ownvim.docker.envCheck": {
          "type": "boolean",
          "default": true,
          "description": "${VAR} без значения в .env — предупреждение"
        },
        "ownvim.go.runMarks": {
          "type": "boolean",
          "default": true,
          "description": "▶ запустить / отладка над func main"
        },
        "ownvim.go.implements": {
          "type": "boolean",
          "default": true,
          "description": "«реализует: io.Reader» над типом"
        },
        "ownvim.docker.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Сервисы compose проекта в строке состояния: работает / всего"
        },
        "ownvim.runMarks": {
          "type": "boolean",
          "default": true,
          "description": "▶ запустить / отладка над if __name__ == \"__main__\" и #!/usr/bin/env node"
        },
        "ownvim.go.autotest": {
          "type": "boolean",
          "default": true,
          "description": "Тесты Go в фоне: при сохранении — go test пакета, ✓/✗ в строке состояния, упавшие проверки — на строках"
        },
        "ownvim.music": {
          "type": "boolean",
          "default": true,
          "description": "Музыка в строке состояния (media-control; blocks statusline.right в settings.jsonc ownvim)"
        },
        "ownvim.rest": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Напоминание об отдыхе. null — как в ownvim (modules.rest в settings.jsonc), true/false — своё"
        },
        "ownvim.statusIcon": {
          "type": "boolean",
          "default": true,
          "description": "Значок ownvim слева в строке состояния: RAM и время работы Mac в подсказке, клик — команды"
        }
      }
    },
    "snippets": [
      {
        "language": "go",
        "path": "./snippets/go.json"
      },
      {
        "language": "sql",
        "path": "./snippets/sql.json"
      },
      {
        "language": "python",
        "path": "./snippets/python.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/typescript.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "ownvim",
        "properties": {}
      },
      {
        "type": "ownvim-task",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "задача из settings.jsonc ownvim (tasks.list)"
          }
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "yaml": "^2.6.1"
  },
  "scripts": {
    "build": "node scripts/themes.js && node scripts/snippets.js && esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --minify --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "test": "esbuild test/run.ts --bundle --platform=node --alias:vscode=./test/vscode-stub.js --external:pg --outfile=test/out.js --log-level=warning && node test/out.js",
    "check": "tsc -p ."
  }
}
